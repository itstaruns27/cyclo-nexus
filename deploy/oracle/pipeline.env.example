# /etc/cyclonexus/pipeline.env — read by both systemd units (chmod 600)

# MOSDAC (https://mosdac.gov.in) — INSAT-3DS/3DR L1C
MOSDAC_USER=
MOSDAC_PASS=
# MOSDAC_DATASET_ID=3SIMG_L1C_ASIA_MER

# NASA Earthdata (https://urs.earthdata.nasa.gov) — approve "NASA GESDISC DATA ARCHIVE" once in your profile
NASA_EARTHDATA_USER=
NASA_EARTHDATA_PASS=

# Must equal WEBHOOK_SECRET on the backend (64 hex chars)
WEBHOOK_SECRET=

# Public backend URL (Hostinger), e.g. https://api.your-domain.in/api/v1
BACKEND_API_URL=https://CHANGE_ME/api/v1

# Co-located inference service (see cyclonexus-inference.service)
INFERENCE_URL=http://127.0.0.1:8000/predict
TENSOR_TRANSPORT=uint8

# Detector thresholds (see docs/validation_report.md before changing)
WATCH_MIN_SCORE=0.95
DETECTION_MIN_CONFIDENCE=0.5
AI_FORECAST_ENABLED=false
