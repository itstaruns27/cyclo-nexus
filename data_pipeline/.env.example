# CYCLO-NEXUS Data Pipeline - Environment Variables
# Copy this file to .env and fill in your actual credentials.

# --- MOSDAC Credentials ---
# Required for INSAT-3DS/3DR Imager L1C ingestion (MOSDAC Data Download API).
# Register at: https://mosdac.gov.in/
MOSDAC_USER=your_mosdac_email@example.com
MOSDAC_PASS=your_mosdac_password
# Optional: product to ingest (default 3SIMG_L1C_ASIA_MER = INSAT-3DS; 3RIMG_L1C_ASIA_MER = INSAT-3DR)
# MOSDAC_DATASET_ID=3SIMG_L1C_ASIA_MER

# --- NASA Earthdata Credentials ---
# Required for GPM IMERG precipitation (GES DISC).
# Register at: https://urs.earthdata.nasa.gov/ and, once, approve the
# "NASA GESDISC DATA ARCHIVE" application under Profile -> Applications -> Authorized Apps.
NASA_EARTHDATA_USER=your_earthdata_username
NASA_EARTHDATA_PASS=your_earthdata_password

# --- Webhook Authentication ---
# Must match the WEBHOOK_SECRET in the Node.js backend environment.
WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Optional service endpoints / thresholds ---
# INFERENCE_URL=http://localhost:8000/predict
# BACKEND_API_URL=http://localhost:3001/api/v1
# DETECTION_MIN_CONFIDENCE=0.5
