# ═══════════════════════════════════════════════
# CYCLO-NEXUS Backend Environment Variables
# Copy to .env and fill in actual values
# ═══════════════════════════════════════════════

# Server
PORT=3001
NODE_ENV=development

# MySQL Database (Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cyclonexus_user
DB_PASSWORD=CHANGE_ME
DB_NAME=cyclonexus_db

# Webhook Authentication
WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Cache TTL (seconds)
CACHE_TTL=30

# Official feed (JTWC + IBTrACS) polling
# In-process interval in minutes (0 = disabled; rely on the cron route instead)
OFFICIAL_FEED_INTERVAL_MIN=30
# Bearer token for POST /api/v1/internal/poll-telemetry (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=CHANGE_ME_TO_64_HEX_CHARS

# Set to 1 when running behind a reverse proxy (Hostinger/Passenger, Nginx)
# TRUST_PROXY=1

# CAP 1.2 alert feed (GET /api/v1/alerts/cap.atom) — sender id and public site link written into each alert
CAP_SENDER=cyclo-nexus
# PUBLIC_SITE_URL=https://your-site.vercel.app
